{
  "version": 3,
  "errorCodes": ["INVALID_PARAMS", "INTERNAL_ERROR", "CONFIG_ERROR", "RUNTIME_BUSY", "RESET_IN_PROGRESS"],
  "compatibilityPolicies": ["release-mismatch-allowed", "requires-schema", "requires-runtime-schema"],
  "requestExamples": {
    "DiagnosticsReportRequest": {"lines": 120},
    "BackendStatusRequest": {"includeHealthRefresh": true, "includeCompatibility": true},
    "CommitImportBatchRequest": {"batchId": "import-1", "reload": true},
    "CommitSubscriptionPreviewRequest": {"previewId": "0123456789abcdef0123456789abcdef"},
    "CompatibilityCheckRequest": {"requiredMethods": ["backend.status"]},
    "ImportNodesBatchRequest": {"batchId": "import-1", "totalBatches": 2, "nodes": [{"id": "node-1", "name": "Local", "protocol": "SOCKS", "server": "127.0.0.1", "port": 10808}]},
    "LogsRequest": {"lines": 100},
    "DNSPatchRequest": {"dns": {"remoteDns": "https://1.1.1.1/dns-query", "directDns": "https://dns.google/dns-query", "bootstrapIp": "1.1.1.1", "ipv6Mode": "MIRROR", "fakeDns": false}},
    "InboundPatchRequest": {"inbounds": {"socksPort": 10808, "httpPort": 10809, "allowLan": false}},
    "NodeRemoveRequest": {"nodeId": "node-1", "reload": true},
    "NodeUpsertRequest": {"node": {"id": "node-1", "name": "Local", "protocol": "SOCKS", "server": "127.0.0.1", "port": 10808, "outbound": {}, "source": {"type": "MANUAL"}}, "reload": true},
    "ProfilePatchRequest": {"activeNodeId": null, "reload": true},
    "RoutingPatchRequest": {"routing": {"mode": "PROXY_ALL", "bypassRussia": true, "alwaysDirectSystemApps": true}},
    "ResolveUidRequest": {"uid": 10123},
    "SelfCheckRequest": {"lines": 80},
    "SetActiveNodeRequest": {"nodeId": "node-1"},
    "SubscriptionURLRequest": {"url": "https://example.com/sub"},
    "TestNodesRequest": {"url": "https://www.gstatic.com/generate_204", "mode": "fast"}
  },
  "operationPolicies": {
    "applyDesiredState": {
      "stages": ["validate", "render", "runtime-idle", "persist-draft", "runtime-apply", "verify", "commit-generation", "cleanup"],
      "errorCodes": ["INVALID_PARAMS", "RUNTIME_BUSY", "RESET_IN_PROGRESS", "CONFIG_ERROR", "INTERNAL_ERROR"]
    },
    "reset": {
      "stages": ["accepted", "activeOperation", "lastOperation"],
      "errorCodes": ["INVALID_PARAMS", "RUNTIME_BUSY", "RESET_IN_PROGRESS", "CONFIG_ERROR", "INTERNAL_ERROR"]
    },
    "restart": {
      "stages": ["accepted", "activeOperation", "lastOperation"],
      "errorCodes": ["INVALID_PARAMS", "RUNTIME_BUSY", "RESET_IN_PROGRESS", "CONFIG_ERROR", "INTERNAL_ERROR"]
    },
    "start": {
